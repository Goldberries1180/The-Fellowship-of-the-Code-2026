<+>\r\nbody {\r\n    margin: 0;\r\n    min-height: 100vh;\r\n\r\n    font-family: \"Inter\", sans-serif;\r\n\r\n    background-color: #1A1612;\r\n\r\n}\r\n\r\n/* =========================\r\n   BASE\r\n========================= */\r\n\r\n:root {\r\n    --color-primary: #8B7355;\r\n    --color-light-grey: #A39989;\r\n\r\n    --color-bg-elements: rgba(26, 22, 18, 0.8);\r\n    --color-bg-navi-btn: rgba(139, 111, 71, 0.2);\r\n    --color-bg-cards: #2A2416;\r\n    --color-text: #FFFFFF;\r\n    --color-bg-darker: #100E0B;\r\n    --color-outline-soft: #3A3228;\r\n\r\n    --shadow-sm: 0 4px 6px -1px rgba(0,0,0,0.10),\r\n                 0 2px 4px -2px rgba(0,0,0,0.10);\r\n\r\n    --radius-md: 12px;\r\n    --radius-lg: 16px;\r\n    --radius-sm: 4px;\r\n}\r\n\r\n\r\n/* =========================\r\n   BUTTONS\r\n========================= */\r\n\r\n.btn {\r\n    display: inline-flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    padding: 10px 25px;\r\n    height: 48px;\r\n    width: 100%;\r\n    max-width: 361px;\r\n\r\n    border-radius: var(--radius-md);\r\n    box-shadow: var(--shadow-sm);\r\n    border: none;\r\n\r\n    font-size: 16px;\r\n    font-weight: 600;\r\n    line-height: 24px;\r\n    color: var(--color-text);\r\n\r\n    cursor: pointer;\r\n}\r\n\r\n/* Primary */\r\n.btn--primary {\r\n    background: var(--color-primary);\r\n}\r\n\r\n.btn--primary:hover {\r\n    background:\r\n        linear-gradient(rgba(0,0,0,0.15), rgba(0,0,0,0.15)),\r\n        var(--color-primary);\r\n}\r\n\r\n.btn--primary:disabled {\r\n    opacity: 0.5;\r\n    cursor: not-allowed;\r\n}\r\n\r\n/* Secondary */\r\n.btn--secondary {\r\n    background: var(--color-bg-elements);\r\n    border: 1px solid var(--color-primary);\r\n}\r\n\r\n.btn--secondary:hover {\r\n    background: linear-gradient(rgba(0,0,0,0.15), rgba(0,0,0,0.15)),\r\n    var(--color-bg-elements);\r\n    \r\n}\r\n\r\n.btn--secondary:disabled {\r\n    opacity: 0.5;\r\n    background: #0E0C09;\r\n    border: 1px solid #A89680;\r\n    cursor: not-allowed;\r\n}\r\n.button-start {\r\n    width: 340px;\r\n    height: 54px;\r\n    display: flex;\r\n    margin: auto;\r\n    padding: 10px 5px;\r\n    position: relative;\r\n    background: var(--color-primary);\r\n    border-radius: 12px;\r\n    border: 1px solid var(--color-primary);\r\n    justify-content: center;\r\n    align-items: center;\r\n    font-size: 16px;\r\n    font-family: Inter, sans-serif;\r\n    color: #F5F1E8;\r\n    cursor: pointer;\r\n}\r\n.start-vote-info {\r\n    align-items: center;\r\n    display: flex;\r\n    position: relative;\r\n    justify-content: center;\r\n    margin-top: 10px;\r\n    color: #A39989;\r\n    font-size: 14px;\r\n    margin-bottom: 10px;\r\n}\r\n\r\n/* =========================\r\n   SEGMENTED CONTROL\r\n========================= */\r\n\r\n/* Container */\r\n.segmented {\r\n    display: flex;\r\n    padding: 6px;\r\n    border-radius: var(--radius-md, 12px);\r\n    background: var(--color-bg-elements);\r\n}\r\n\r\n/* Buttons */\r\n.segmented__button {\r\n    flex: 1;\r\n    height: 54px;\r\n\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n\r\n    border: none;\r\n    border-radius: var(--radius-md, 12px);\r\n    background: transparent;\r\n\r\n    font-family: \"Inter\", sans-serif;\r\n    font-size: 16px;\r\n    font-weight: 600;   \r\n\r\n    color: rgba(255, 255, 255, 0.7);\r\n    cursor: pointer;\r\n\r\n    transition: all 0.2s ease;\r\n}\r\n\r\n/* Active */\r\n.segmented__button.is-active {\r\n    background: #8B7355;\r\n    color: #FFF;\r\n\r\n    box-shadow: \r\n        0 4px 10px rgba(0,0,0,0.25),\r\n        inset 0 1px 0 rgba(255,255,255,0.1);\r\n}\r\n\r\n\r\n/* =========================\r\n   INPUTS\r\n========================= */\r\n\r\n/* Base Input */\r\n.input {\r\n    width: 100%;\r\n    padding: 12px 16px;\r\n\r\n    font-family: \"Inter\", sans-serif;\r\n    font-size: 16px;\r\n    font-weight: 400;\r\n    line-height: 24px;\r\n\r\n    color: var(--color-light-grey);\r\n\r\n    border-radius: var(--radius-md);\r\n    border: 1px solid var(--color-outline-soft);\r\n    background: rgba(26, 22, 18, 0.8);\r\n    box-shadow: var(--shadow-sm);\r\n}\r\n\r\n/* Größen */\r\n.input--small {\r\n    max-width: 340px;\r\n    height: 48px;\r\n}\r\n\r\n.input--large {\r\n    max-width: 340px;\r\n    height: 100px;\r\n}\r\n\r\n/* Fokus */\r\n.input:focus {\r\n    outline: none;\r\n    border: 1px solid var(--color-text);\r\n}\r\n\r\n/* Filled */\r\n.input:not(:placeholder-shown) {\r\n    color: var(--color-text);\r\n}\r\n\r\n\r\n/* =========================\r\n   CARDS\r\n========================= */\r\n\r\n.card {\r\n\r\n    border-radius: var(--radius-lg);\r\n}\r\n\r\n/* Voting */\r\n.card--voting {\r\n    max-width: 340px;\r\n    height: 131px;\r\n    border: 1px solid #3A3228;\r\n    background: #2C2416;\r\n}\r\n\r\n.card--voting.is-selected {\r\n    max-width: 340px;\r\n    border-color: #7A5D47;\r\n    background: #1C160E;\r\n}\r\n\r\n\r\n/* Results */\r\n.card--results {\r\n    max-width: 340px;display: flex;\r\n    flex-direction: column;\r\n    padding: 1px;\r\n    border: 1px solid #3A3228;\r\n    background: #2C2416;\r\n}\r\n\r\n.card--results.is-lost {\r\n    height: 110px;\r\n}\r\n\r\n.card--results.is-chosen {\r\n    height: 163px;\r\n    border-color: #7F6641;\r\n}\r\n\r\n\r\n/* Info */\r\n.card--info {\r\n    max-width: 340px;\r\n    width: 100%;\r\n    min-height: 72px;\r\n    padding: 16px;\r\n    box-sizing: border-box;\r\n\r\n    border: 1px solid rgba(139, 111, 71, 0.3);\r\n    border-radius: var(--radius-lg);\r\n    background: rgba(139, 111, 71, 0.2);\r\n\r\n    font-family: \"Inter\", sans-serif;\r\n    font-size: 16px;\r\n    color: var(--color-text);\r\n\r\n    resize: none;\r\n}\r\n\r\n.card--info::placeholder {\r\n    color: var(--color-light-grey);\r\n}\r\n\r\n.card--info:focus {\r\n    outline: none;\r\n    border-color: var(--color-text);\r\n}\r\n\r\n/* Bottom Navigation */\r\n.bottomnav {\r\n    position: fixed;\r\n    left: 0;\r\n    right: 0;\r\n    bottom: 0;\r\n    z-index: 100;\r\n    display: flex;\r\n    justify-content: center;\r\n    gap: 48px;\r\n    align-items: center;\r\n    height: 64px;\r\n    padding: 0 36px;\r\n    box-sizing: border-box;\r\n    background: var(--color-bg-elements);\r\n    border-top: 1px solid var(--color-outline-soft);\r\n}\r\n\r\n.bottomnav__button {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n\r\n    width: 40px;\r\n    height: 40px;\r\n    padding: 8px;\r\n    box-sizing: border-box;\r\n    border: 0;\r\n    border-radius: var(--radius-lg);\r\n    background: transparent;\r\n    color: #E8E3D6;\r\n    cursor: pointer;\r\n}\r\n\r\n.bottomnav__button.is-active {\r\n    background: var(--color-bg-navi-btn);\r\n}\r\n\r\n.bottomnav__button img {\r\n    width: 24px;\r\n    height: 24px;\r\n    display: block;\r\n}\r\n\r\n.nav__back {\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n\r\n    background: transparent;\r\n    border: 0;\r\n    padding: 0;\r\n\r\n    color: var(--color-text);\r\n    font-family: \"Inter\", sans-serif;\r\n    font-size: 16px;\r\n    font-weight: 600;\r\n\r\n    cursor: pointer;\r\n}\r\n\r\n.nav__back svg {\r\n    width: 6px;\r\n    height: 12px;\r\n    display: block;\r\n}\r\n\r\nbody {\r\n    margin: 0;\r\n    padding-bottom: 64px;\r\n}\r\n\r\n/* =========================\r\n   ROUTING STYLES (from style.css)\r\n========================= */\r\n\r\n.route-header {\r\n    color: #E8E3D6;\r\n    font-family: Inter, sans-serif;\r\n    font-size: 24px;\r\n    font-style: normal;\r\n    font-weight: 600;\r\n    line-height: 32px;\r\n\r\n    padding-left: 25px;\r\n}\r\n.route-sub-header {\r\n    color: var(--color-text, #FFFFFF);\r\n    font-family: Inter, sans-serif;\r\n    font-size: 16px;\r\n    font-style: normal;\r\n    font-weight: 400;\r\n    line-height: 24px;\r\n    padding-left: 25px;\r\n}\r\n.info-icon {\r\n    position: absolute;\r\n    top: -24px;\r\n    right: 0;\r\n}\r\n.info-icon:hover {\r\n    cursor: pointer;\r\n}\r\n.switch-toggle {\r\n    display: none;\r\n}\r\n.new-switch {\r\n    width: 340px;\r\n    height: 34px;\r\n    padding: 10px 5px;\r\n    position: relative;\r\n    background: var(--color-bg-elements);\r\n    border-radius: 12px;\r\n    border: 1px solid var(--color-primary);\r\n    justify-content: center;\r\n    align-items: center;\r\n    display: flex;\r\n    margin: 20px auto;\r\n}\r\n\r\n.new-switch__option {\r\n    width: 165px;\r\n    height: 26px;\r\n    padding: 8px 16px;\r\n    border-radius: 12px;\r\n    justify-content: center;\r\n    align-items: center;\r\n    gap: 10px;\r\n    display: flex;\r\n    cursor: pointer;\r\n}\r\n\r\n.new-switch__option--active {\r\n    background: var(--color-primary);\r\n    box-shadow: 0 2px 8px rgba(26, 22, 18, 0.60);\r\n    color: #F5F1E8;\r\n    font-weight: 600;\r\n    line-height: 24px;\r\n    word-wrap: break-word;\r\n}\r\n\r\n.new-switch__option--inactive {\r\n    background: var(--color-bg-elements);\r\n    color: #F5F1E8;\r\n    font-weight: 600;\r\n    line-height: 24px;\r\n    word-wrap: break-word;\r\n}\r\n\r\n.new-switch__label {\r\n    text-align: center;\r\n    color: #F5F1E8;\r\n    font-size: 16px;\r\n    font-family: Inter , sans-serif;\r\n    font-weight: 600;\r\n    line-height: 24px;\r\n    word-wrap: break-word;\r\n}\r\n.switch-toggle:checked + .new-switch .new-switch__option--active {\r\n    background: transparent;\r\n    box-shadow: none;\r\n}\r\n.switch-toggle:checked + .new-switch .new-switch__option--inactive {\r\n    background: var(--color-primary);\r\n    box-shadow: 0 2px 8px rgba(26, 22, 18, 0.60);\r\n}\r\n\r\n.route-options {\r\n    align-items: center;\r\n    width: 340px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    padding: 30px 40px;\r\n    margin: 0 auto 0;\r\n    color: #E8E3D6;\r\n}\r\ncheckbox {\r\n    width: 20px;\r\n    height: 20px;\r\n}\r\n.checkbox-grid {\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr;\r\n    gap: 10px;\r\n    width: 100%;\r\n    align-items: flex-start;\r\n    column-count: 2;\r\n}\r\n.checkbox-grid label {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n}\r\n.checkbox-column {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 8px;\r\n    flex: 1;\r\n}\r\n.checkbox-column label {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n    font-size: 16px;\r\n    font-family: Inter, sans-serif;\r\n    font-weight: 400;\r\n    line-height: 24px;\r\n}\r\ninput[type=\"checkbox\"] {\r\n    appearance: none;\r\n    width: 20px;\r\n    height: 20px;\r\n    border-radius: 4px;\r\n    border: 1px solid var(--color-primary);\r\n    background-color: transparent;\r\n    cursor: pointer;\r\n    flex-shrink: 0;\r\n}\r\ninput[type=\"checkbox\"]:checked {\r\n    background-image: url('../assets/icons/Checkbox.svg');\r\n    background-size: cover;\r\n    border: none;\r\n}\r\n.source-select {\r\n    width: 340px;\r\n    height: 36px;\r\n    margin-top: 8px;\r\n    color: #A39989;\r\n    font-size: 16px;\r\n    font-family: Inter, sans-serif;\r\n    font-weight: 400;\r\n    line-height: 24px;\r\n    padding: 0 8px 0 8px;\r\n    background: var(--color-bg-elements);\r\n    border: 0.68px solid #a39989;\r\n    border-radius: 12px;\r\n    appearance: none;\r\n    background-image: url('../assets/icons/Icon_Dropdown.svg');\r\n    background-repeat: no-repeat;\r\n    background-position: right 16px center;\r\n}\r\n.card-headline {\r\n    font-size: 24px;\r\n    font-weight: 600;\r\n    margin-bottom: 10px;\r\n    text-align: left !important;\r\n    align-self: flex-start;\r\n    width: 100%;\r\n}\r\n.option_name {\r\n    width: 340px;\r\n    height: 50px;\r\n    margin-top: 8px;\r\n    background: var(--color-bg-elements);\r\n    border: 0.68px solid #a39989;\r\n    border-radius: 12px;\r\n}\r\ninput::placeholder {\r\n    color: #A39989;\r\n    